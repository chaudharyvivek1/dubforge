# Copy to .env and fill in only what you use. dubforge reads these from the
# environment; it never reads a .env file itself, so either `export` them or use
# `dubforge ... --config settings.json`.
#
# Never commit real keys. `dubforge doctor` shows which of these are set, never
# their values.

# --- speech recognition -------------------------------------------------------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- translation --------------------------------------------------------------
GEMINI_API_KEY=
SARVAM_API_KEY=
DEEPL_API_KEY=
# local model instead: ollama serve
DUBFORGE_OLLAMA_URL=http://localhost:11434

# --- voice --------------------------------------------------------------------
GOOGLE_API_KEY=

# --- optional -----------------------------------------------------------------
SYNCLABS_API_KEY=

# --- overrides ----------------------------------------------------------------
# DUBFORGE_FFMPEG=/usr/local/bin/ffmpeg
# DUBFORGE_WORKDIR=dubforge-work
# DUBFORGE_TARGET_LANG=hi
# DUBFORGE_MAX_SPEED=1.15
# DUBFORGE_KEEP_BACKGROUND=true
